# Secrets and credentials
.env
cookies/*.txt
cookies/instagram.txt
cookies/tiktok.txt
cookies/reddit.txt
cookies/facebook.txt
# Captured login state — contains auth tokens. Persistent profiles carry IndexedDB
# (Firebase auth); _session.json carries cookies + localStorage + sessionStorage.
cookies/*_profile/
cookies/*_session.json

# Local dev config overrides (never commit — contains machine-specific paths)
config.local.yaml
docker/.env

# Runtime state directory (bare-metal dev keeps state JSONs here too)
state/

# Runtime state
processing_state.json
pending_approvals.json
queue_state.json
preferences.json
logs/

# Debug / inspection screenshots (may show authenticated account state — never commit)
screenshots/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.eggs/
*.egg-info/
dist/
build/

# Whisper / ML cache
*.pt

# OS
.DS_Store
Thumbs.db
