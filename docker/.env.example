# Host-specific deployment paths — copy this file to docker/.env and adjust per machine.
# docker/.env is gitignored; docker-compose reads it automatically when run from docker/.
# This is the ONLY file that changes when deploying to a different host.

# --- Container identity -----------------------------------------------------
# CONFIRMED against `id sa_saves` on the NAS (2026-08-06):
#   uid=1031(sa_saves) gid=100(users) groups=100(users),65536(docker_service_accounts)
# The container runs as UID:GID, where GID is the SERVICE group (65536) — deliberately
# tighter than DSM's broad `users`. Naming/group convention: docs/NAS_SERVICE_ACCOUNTS.md.
# Getting this wrong = every write fails with EACCES.
SAVES_UID=1031
SAVES_GID=65536

# Supplementary group(s). Docker does NOT inherit the DSM account's supplementary groups —
# `user:` grants exactly one GID — so `users` (100) must be restated here or SAVES cannot
# write the vault/media, which are group-`users` shared data.
# Only list groups sa_saves ACTUALLY has (see the id output above).
SAVES_EXTRA_GID=100

# --- Host paths -------------------------------------------------------------
# CONFIRMED real paths (2026-08-06). The earlier /volume1/NAS/... values were guesses and
# did not exist. preflight [3] fails if either is missing.
#   VAULT lives in the APPS tree and is owned by sa_obsidian (1032) — SAVES writes into
#   another app's directory via group `users` + setgid. See NAS_SERVICE_ACCOUNTS.md §6.
VAULT_HOST=/volume1/APPS/OBSIDIAN/Remote Vault
MEDIA_HOST=/volume1/MEDIA/SAVES
# Runtime state directory (processing_state.json, pending_approvals.json, preferences.json).
# Create it once before first `up`: mkdir -p /volume1/docker/saves/state
STATE_HOST=/volume1/docker/saves/state

# Container timezone (saved_date in note frontmatter uses this)
TZ=America/New_York

# Memory cap for the saves_app container. The NAS is shared with the Forgejo forge
# (Forgejo 2g + PostgreSQL 1g), and Chromium/Playwright + ffmpeg are the memory-hungry
# parts of the pipeline. Leave headroom for DSM itself (~1-2g).
#   4 GB NAS  -> 1g   (tight; expect slower Chromium, consider a RAM upgrade)
#   8 GB NAS  -> 3g
#   16 GB+    -> 4g
# This NAS (DS1621+) was measured at 32 GB total / ~29 GB available on 2026-08-06, so 4g
# is comfortable — it is a CAP, not a reservation, and SAVES peaks well under it.
# `sh scripts/preflight_nas.sh` check [6] prints total RAM and flags an over-commit.
# NOTE: do NOT add a CPU limit anywhere — Synology kernels reject it and the deploy fails.
SAVES_MEM_LIMIT=4g
